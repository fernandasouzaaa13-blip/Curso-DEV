//Exercício 5 - WHILE
Pedir a senha até acertar.
Scanner scanner = new Scanner(System.in);
int senha = 0;
while (senha != 1234) {
    System.out.print("Digite a senha: ");
    senha = scanner.nextInt();
}
System.out.println("Senha correta!");
scanner.close();



