//Exercício 4 - DO WHILE
Pedir um número positivo.
Scanner scanner = new Scanner(System.in);
int numero;
do {
    System.out.print("Digite um número positivo: ");
    numero = scanner.nextInt();
} while (numero <= 0);
System.out.println("Número válido!");
scanner.close();

