// Dica //Se você vai usar cores com frequência, pode criar uma classe para não precisar decorar os códigos:
public class Cor {
    public static final String RESET = "\u001B[0m";
    public static final String VERMELHO = "\u001B[31m";
    public static final String VERDE = "\u001B[32m";
    public static final String AMARELO = "\u001B[33m";
    public static final String AZUL = "\u001B[34m";
    public static final String ROXO = "\u001B[35m";
    public static final String CIANO = "\u001B[36m";
}
//Depois é só usar:
System.out.println(Cor.VERDE + "Programa iniciado!" + Cor.RESET);
System.out.println(Cor.VERMELHO + "Erro!" + Cor.RESET);
System.out.println(Cor.AMARELO + "Atenção!" + Cor.RESET);

